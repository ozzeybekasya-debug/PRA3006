#title: Genes linked to four human metabolic pathways
SELECT DISTINCT ?wpid ?pathwayLabel ?gene ?geneLabel
WHERE {
  # Select the four pathways for the pilot
  VALUES ?wpid {
    "WP534"  # Glycolysis and gluconeogenesis
    "WP134"  # Pentose phosphate metabolism
    "WP690"  # Polyol pathway
    "WP78"   # TCA cycle
  }

  # Find the human pathways and their recorded members
  ?pathway wdt:P2410 ?wpid ;
           wdt:P703 wd:Q15978631 ;
           wdt:P527 ?gene .

  # Keep members that Wikidata explicitly classifies as genes
  ?gene wdt:P31 wd:Q7187 .

  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "en" .
  }
}
ORDER BY ?wpid ?geneLabel